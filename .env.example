# Network Telescope - Capturing Node Environment
# Edit these values before running start.sh

# --Node settings----------------------------------------------------------
PROJECT_ROOT=
DATA_DIR=
NT_HOME=

# --Capture settings-------------------------------------------------------
INTERFACE=

# List of individual global IP addresses or subnets in network CIDR notation (where the prefix matches its network boundary).
# Example: DARKNET_NETS=198.51.100.42,66.245.204.0/23
DARKNET_NETS=

# Max PCAP files kept (one per DURATION). The oldest are deleted even if not yet transferred,
# so size it from the disk and the expected MB per file. 0 = no limit (the disk can fill up).
RING_BUFFER_SIZE=24
DURATION=3600

# --Transfer settings------------------------------------------------------
SWEEP_MIN_AGE=600
TRANSFER_MODE=remote
REMOTE_USER=telescope
REMOTE_HOST=
REMOTE_DIR=/var/lib/network-telescope/data/queue
SSH_KEY_PATH=

# --CPU pinning------------------------------------------------------------
CAPTURE_CPUS=
DETECTOR_CPUS=